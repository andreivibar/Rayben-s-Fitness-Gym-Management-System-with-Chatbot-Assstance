# PayMongo API Credentials (TEST MODE ONLY)
# Get your keys from: https://dashboard.paymongo.com/
#
# IMPORTANT:
# - Use TEST mode keys starting with 'sk_test_' and 'pk_test_'
# - NEVER commit your real secret keys to GitHub
# - Keep this file on the PHP backend only

PAYMONGO_SECRET_KEY=sk_test_your_test_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_test_public_key_here
PAYMONGO_WEBHOOK_SECRET=whsk_test_your_test_webhook_secret_here
PAYMONGO_TEST_MODE=true

# Frontend base URL for checkout redirects (defaults to localhost:5173 for Vite React dev)
APP_FRONTEND_URL=http://localhost:5173

# Password reset mail is sent server-side through Gmail SMTP.
# Use a Gmail App Password after enabling 2-Step Verification.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
MAIL_FROM_NAME=Rayben's Gym

# Generate a random secret of at least 32 bytes and configure it only in the server environment.
PASSWORD_RESET_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-bytes
